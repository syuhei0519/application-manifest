{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "imagePullSecrets",
    "release",
    "serviceAccount",
    "service",
    "config",
    "secrets",
    "resources",
    "podSecurityContext",
    "securityContext",
    "probes",
    "migration",
    "restartNonce",
    "telemetry"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": ["IfNotPresent", "Never"]
        }
      }
    },
    "release": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceProjectId",
            "sourceCommit",
            "pipelineId",
            "pipelineUrl"
          ],
          "properties": {
            "sourceProjectId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "pipelineId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "pipelineUrl": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schemaVersion",
            "sourceProjectId",
            "sourceCommit",
            "buildPipelineId",
            "buildJobId",
            "scanPipelineId",
            "scanJobId",
            "recordUrl",
            "recordSha256",
            "sbomUrl",
            "sbomSha256"
          ],
          "properties": {
            "schemaVersion": {
              "const": "2"
            },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "recordSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "buildJobId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "recordUrl": {
              "format": "uri",
              "type": "string"
            },
            "buildPipelineId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "sbomSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scanJobId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "sbomUrl": {
              "format": "uri",
              "type": "string"
            },
            "sourceProjectId": {
              "const": "86247033"
            },
            "scanPipelineId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "pipelineId": {
              "type": "null"
            },
            "pipelineUrl": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "sourceRepository",
            "sourceCommit",
            "runId",
            "runAttempt",
            "recordUrl",
            "sbomUrl",
            "recordSha256",
            "sbomSha256"
          ],
          "properties": {
            "schemaVersion": {
              "const": "github-v1"
            },
            "sourceRepository": {
              "const": "syuhei0519/backend-app"
            },
            "sourceCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "runId": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "runAttempt": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "recordUrl": {
              "type": "string",
              "pattern": "^https://github\\.com/syuhei0519/backend-app/releases/download/gha-[0-9a-f]{40}-[1-9][0-9]*-[1-9][0-9]*/release-record\\.json$"
            },
            "sbomUrl": {
              "type": "string",
              "pattern": "^https://github\\.com/syuhei0519/backend-app/releases/download/gha-[0-9a-f]{40}-[1-9][0-9]*-[1-9][0-9]*/sbom\\.cdx\\.json$"
            },
            "recordSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sbomSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"const": "registry-backend-pull"}}
      }
    },
    "serviceAccount": {
      "const": {"name": "backend", "automountServiceAccountToken": false}
    },
    "service": {
      "const": {"type": "ClusterIP", "port": 8080}
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dbHost", "dbPort", "dbName", "sslmode", "logLevel"],
      "properties": {
        "dbHost": {"const": "postgresql"},
        "dbPort": {"const": 5432},
        "dbName": {"const": "account"},
        "sslmode": {"const": "disable"},
        "logLevel": {"enum": ["debug", "info", "warn", "error"]}
      }
    },
    "secrets": {
      "const": {"existingSecret": "account-db", "usernameKey": "app-username", "passwordKey": "app-password"}
    },
    "resources": {
      "const": {"requests": {"cpu": "100m", "memory": "64Mi"}, "limits": {"cpu": "500m", "memory": "256Mi"}}
    },
    "podSecurityContext": {
      "const": {"runAsUser": 10001, "runAsGroup": 10001, "fsGroup": 10001, "runAsNonRoot": true, "seccompProfile": {"type": "RuntimeDefault"}}
    },
    "securityContext": {
      "const": {"allowPrivilegeEscalation": false, "readOnlyRootFilesystem": true, "capabilities": {"drop": ["ALL"]}}
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": {"$ref": "#/definitions/startupProbe"},
        "liveness": {"$ref": "#/definitions/livenessProbe"},
        "readiness": {"$ref": "#/definitions/readinessProbe"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeDeadlineSeconds", "backoffLimit"],
      "properties": {
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 300},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "restartNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{0,64}$"
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpoint",
        "environment"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "const": "http://otel-collector.observability.svc.cluster.local:4318"
        },
        "environment": {
          "const": "local"
        }
      }
    }
  },
  "definitions": {
    "startupProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "path": {"const": "/livez"},
        "periodSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "failureThreshold": {"type": "integer", "minimum": 3, "maximum": 60}
      }
    },
    "livenessProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "path": {"const": "/livez"},
        "periodSeconds": {"type": "integer", "minimum": 5, "maximum": 30},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "readinessProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "path": {"const": "/readyz"},
        "periodSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 10},
        "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    }
  }
}
