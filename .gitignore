# ローカルのビルド結果や一時ファイルを、Git の変更一覧から除くための設定です。
*.local.yaml
.env*
.rendered/
.build/
.trusted/
__pycache__/
.security/
.validation/
.oci/
.oci-budget-*/

# Generated evidence stays in CI artifacts.
/docs/evidence/**
!/docs/evidence/
!/docs/evidence/README.md

# Immutable shared modules are materialized by ci/shared-tools.sh.
/tools/release-record/
/tools/scan-gate/
