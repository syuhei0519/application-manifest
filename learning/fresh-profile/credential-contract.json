{
  "schemaVersion": "platform-lab/credential-contract/v2",
  "profile": "fresh-account",
  "namespace": "fresh-account",
  "credentialSet": {
    "owner": "personal-platform-lab",
    "purpose": "Account PostgreSQL authentication for one isolated fresh profile",
    "expiry": {
      "maxAgeDays": 30,
      "expiredBehavior": "fail-closed",
      "evidence": "non-secret issued-at and rotation-deadline record"
    },
    "storageAndRecovery": {
      "provider": "manual-bootstrap",
      "gitStorage": "forbidden",
      "ciLogStorage": "forbidden",
      "recoverySource": "PENDING_G3",
      "firstInput": {
        "method": "approved-manual-input",
        "generatedByRepository": false,
        "readBack": "metadata-and-key-names-only"
      },
      "existingCredentialTransfer": "separate-approval-required",
      "freshIsolatedCredentialsPreferred": true
    },
    "missingDeniedOrUnavailable": {
      "podStart": "reject",
      "migration": "reject",
      "readiness": "not-ready",
      "fallbackCredential": "forbidden"
    }
  },
  "secrets": {
    "bootstrap": {
      "name": "account-db-bootstrap",
      "purpose": "PostgreSQL bootstrap and recovery only",
      "keys": ["admin-password"],
      "consumers": ["StatefulSet/account-postgresql", "Job/account-db-role-bootstrap"]
    },
    "migration": {
      "name": "account-db-migration",
      "purpose": "Account owned-schema migration",
      "keys": ["username", "password"],
      "consumers": ["Job/account-db-role-bootstrap", "Job/account-migration"]
    },
    "runtime": {
      "name": "account-db-runtime",
      "purpose": "Account API runtime DML",
      "keys": ["username", "password"],
      "consumers": ["Job/account-db-role-bootstrap", "Rollout/account-api"]
    }
  },
  "transportTrust": {
    "sandboxCA": "generate-in-fresh-sandbox-after-G3-approval",
    "gitMaterial": "forbidden",
    "existingCAReadOrTransfer": "separate-approval-required",
    "metadataEvidenceOnly": true
  },
  "database": {
    "name": "account",
    "schema": "account",
    "admin": {
      "role": "postgres",
      "use": "bootstrap-and-recovery-only",
      "applicationAccess": false
    },
    "migration": {
      "role": "account_migrator",
      "databaseOwner": false,
      "ownedSchemas": ["account"],
      "ddlSchemas": ["account"],
      "canCreateDatabase": false,
      "canCreateRole": false,
      "superuser": false
    },
    "runtime": {
      "role": "account_runtime",
      "databaseOwner": false,
      "schemaOwner": false,
      "dmlSchemas": ["account"],
      "ddlSchemas": [],
      "crossServiceWrite": false,
      "canCreateDatabase": false,
      "canCreateRole": false,
      "superuser": false
    }
  },
  "rotation": {
    "processReload": "pod-restart-required",
    "steps": [
      "new-database-auth-verified",
      "application-process-restarted",
      "application-ready",
      "new-process-auth-verified",
      "old-credential-revoked",
      "old-credential-rejected"
    ],
    "rollbackBeforeRevocation": "restore-old-secret-reference-and-restart",
    "liveEvidence": "required-unrun"
  }
}
