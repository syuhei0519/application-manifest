  },
  "devDependencies": {
    "@backstage/cli": "0.36.7",
    "@backstage/cli-defaults": "0.1.7",
    "@types/jest": "30.0.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "jest": "30.5.0",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "@yarnpkg/core": "4.9.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  }
}
